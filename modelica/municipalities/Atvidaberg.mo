        births = 101,
        deaths = 141)
        "Åtvidaberg vid slutet av 2025; dödlighetskvot 2021-2025, restflöden 2023-2025";
    end SCB;
    constant Real olderShares[3] = {0.675249, 0.27422, 0.050531} "Andel av 65+ som är 65-79, 80-89 och 90+ vid slutet av 2025 (SCB)";
    annotation(Documentation(info = "<html><p>Källa: SCB, Statistikdatabasen (CC BY 4.0): räkenskapssammandraget (TAB6777, TAB6779,
TAB6782, TAB4202, TAB5179), befolkningen per ettårsålder och befolkningsförändringar; Kolada för omsorgskostnad per invånare
och nettokostnad per verksamhet. Arkiv data/downloads/20261119T090411Z. Kompletteringar från årsredovisning och kontroll av total befolkning dokumenteras i respektive kommuns data. Anläggningstillgångarna innehåller
pågående arbeten, som SCB inte särredovisar. Definitionerna står i scripts/prepare_municipality.py.</p></html>"));
  end Data;

  model Annual "Åtvidabergs ekonomi år för år från bokslutet 2025"
    extends Kommunekonomi.Annual(base = Data.atvidaberg2025, olderShares = Data.olderShares);
    annotation(experiment(StartTime = 2025, StopTime = 2033, Interval = 1),
      Documentation(info = "<html><p><b>Tid: start 2025, slut 2033.</b> Med standardantagandena (illustrativ tillväxt).
Starta från ett annat år med <code>Annual(base = Data.atvidaberg2024)</code>.</p></html>"));
  end Annual;

  model Continuous "Åtvidabergs ekonomi med kontinuerlig tid inom året: lager och flöden"
    extends Kommunekonomi.Continuous.Economy(base = Data.atvidaberg2025, olderShares = Data.olderShares);
    annotation(experiment(StartTime = 2025, StopTime = 2033, Interval = 0.0833333333333333),
      Documentation(info = "<html><p><b>Tid: start 2025, slut 2033.</b> Samma antaganden och utdata som Annual, men pengarna
är lager och flöden i kontinuerlig tid inom året (Kommunekonomi.Continuous.Economy).</p></html>"));
  end Continuous;

  package Examples "Färdiga modeller att simulera"
    model Hindcast2025 "Starta i bokslutet 2024 och räkna fram 2025; jämför med utfallet i Data.atvidaberg2025"
      extends Annual(base = Data.atvidaberg2024, olderShares = Data.olderShares2024, horizon = 1);
      annotation(experiment(StartTime = 2024, StopTime = 2025, Interval = 1));
    end Hindcast2025;
  end Examples;
  annotation(uses(Kommunekonomi(version = "0.1.0")), Documentation(info = "<html><p>Åtvidaberg (kommunkod 0561) med biblioteket
<a href=\"modelica://Kommunekonomi\">Kommunekonomi</a>. Data från SCB och Kolada, genererade av scripts/prepare_municipality.py.
Detta är en forskningsmodell, inte kommunens prognos.</p></html>"));
end Atvidaberg;
