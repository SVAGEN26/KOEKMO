    constant Real olderShares[3] = {0.690987, 0.270639, 0.038374} "Andel av 65+ som är 65-79, 80-89 och 90+ vid slutet av 2025 (SCB)";
    annotation(Documentation(info = "<html><p>Källa: SCB, Statistikdatabasen (CC BY 4.0): räkenskapssammandraget (TAB6777, TAB6779,
TAB6782, TAB4202, TAB5179), befolkningen per ettårsålder och befolkningsförändringar; Kolada för omsorgskostnad per invånare
och nettokostnad per verksamhet. Arkiv data/downloads/20261119T090541Z. Kompletteringar från årsredovisning och kontroll av total befolkning dokumenteras i respektive kommuns data. Anläggningstillgångarna innehåller
pågående arbeten, som SCB inte särredovisar. Skulden är kommunens egna lån: det som
kommunen har lånat upp och lånat vidare till sina bolag ingår inte, och räntan på den delen är borttagen ur både
räntekostnad och finansiella intäkter. Definitionerna står i scripts/prepare_municipality.py.</p></html>"));
  end Data;

  model Continuous "Söderköpings ekonomi med kontinuerlig tid inom året: lager och flöden"
    // Söderköping: finanspolicyn (KF december 2023) är inte publicerad; standard 30 dagar. Checkkredit 70 mnkr
    // tillsammans med Ramunderstaden AB "för att säkerställa betalningsberedskapen" (årsredovisning 2025, avsnitt
    // 1.3.6). Källa: årsredovisningen, se data/liquidity.json.
    extends Kommunekonomi.Continuous.Economy(base = Data.soderkoping2025, olderShares = Data.olderShares, reserveDays = 30, creditLine = 70);
    annotation(experiment(StartTime = 2025, StopTime = 2033, Interval = 0.0833333333333333),
      Documentation(info = "<html><p><b>Tid: start 2025, slut 2033.</b> Med standardantagandena (illustrativ tillväxt).
Pengar och invånare är lager och flöden i kontinuerlig tid inom året (Kommunekonomi.Continuous.Economy). Starta från
ett annat år med <code>Continuous(base = Data.soderkoping2024)</code>.</p></html>"));
  end Continuous;

  package Examples "Färdiga modeller att simulera"
    model Hindcast2025 "Starta i bokslutet 2024 och räkna fram 2025; jämför med utfallet i Data.soderkoping2025"
      extends Continuous(base = Data.soderkoping2024, olderShares = Data.olderShares2024, horizon = 1);
      annotation(experiment(StartTime = 2024, StopTime = 2025, Interval = 0.0833333333333333));
    end Hindcast2025;
  end Examples;
  annotation(uses(Kommunekonomi(version = "0.1.0")), Documentation(info = "<html><p>Söderköping (kommunkod 0582) med biblioteket
<a href=\"modelica://Kommunekonomi\">Kommunekonomi</a>. Data från SCB och Kolada, genererade av scripts/prepare_municipality.py.
Detta är en forskningsmodell, inte kommunens prognos.</p></html>"));
end Soderkoping;
