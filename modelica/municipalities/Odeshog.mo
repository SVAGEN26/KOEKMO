    constant Real olderShares[3] = {0.690013, 0.256161, 0.053826} "Andel av 65+ som är 65-79, 80-89 och 90+ vid slutet av 2025 (SCB)";
    annotation(Documentation(info = "<html><p>Källa: SCB, Statistikdatabasen (CC BY 4.0): räkenskapssammandraget (TAB6777, TAB6779,
TAB6782, TAB4202, TAB5179), befolkningen per ettårsålder och befolkningsförändringar; Kolada för omsorgskostnad per invånare
och nettokostnad per verksamhet. Arkiv data/downloads/20261119T090358Z. Kompletteringar från årsredovisning och kontroll av total befolkning dokumenteras i respektive kommuns data. Anläggningstillgångarna innehåller
pågående arbeten, som SCB inte särredovisar. Skulden är kommunens egna lån: det som
kommunen har lånat upp och lånat vidare till sina bolag ingår inte, och räntan på den delen är borttagen ur både
räntekostnad och finansiella intäkter. Definitionerna står i scripts/prepare_municipality.py.</p></html>"));
  end Data;

  model Continuous "Ödeshögs ekonomi med kontinuerlig tid inom året: lager och flöden"
    // Ödeshög: betalningsberedskap om 30 betalningsdagar (Finanspolicy, KF 2017-05-16 § 21, avsnitt 4.2).
    // Checkräkningskredit 15 mnkr (årsredovisning 2025, s. 22; samma 2021–2024). Källa:
    // https://www.odeshog.se/download/18.50544c211605519723d77efb/1698130602843/Finanspolicy-t.pdf
    extends Kommunekonomi.Continuous.Economy(base = Data.odeshog2025, olderShares = Data.olderShares, reserveDays = 30, creditLine = 15);
    annotation(experiment(StartTime = 2025, StopTime = 2033, Interval = 0.0833333333333333),
      Documentation(info = "<html><p><b>Tid: start 2025, slut 2033.</b> Med standardantagandena (illustrativ tillväxt).
Pengar och invånare är lager och flöden i kontinuerlig tid inom året (Kommunekonomi.Continuous.Economy). Starta från
ett annat år med <code>Continuous(base = Data.odeshog2024)</code>.</p></html>"));
  end Continuous;

  package Examples "Färdiga modeller att simulera"
    model Hindcast2025 "Starta i bokslutet 2024 och räkna fram 2025; jämför med utfallet i Data.odeshog2025"
      extends Continuous(base = Data.odeshog2024, olderShares = Data.olderShares2024, horizon = 1);
      annotation(experiment(StartTime = 2024, StopTime = 2025, Interval = 0.0833333333333333));
    end Hindcast2025;
  end Examples;
  annotation(uses(Kommunekonomi(version = "0.1.0")), Documentation(info = "<html><p>Ödeshög (kommunkod 0509) med biblioteket
<a href=\"modelica://Kommunekonomi\">Kommunekonomi</a>. Data från SCB och Kolada, genererade av scripts/prepare_municipality.py.
Detta är en forskningsmodell, inte kommunens prognos.</p></html>"));
end Odeshog;
