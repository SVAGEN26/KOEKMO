    constant Real olderShares[3] = {0.679481, 0.264829, 0.05569} "Andel av 65+ som är 65-79, 80-89 och 90+ vid slutet av 2025 (SCB)";
    annotation(Documentation(info = "<html><p>Källa: SCB, Statistikdatabasen (CC BY 4.0): räkenskapssammandraget (TAB6777, TAB6779,
TAB6782, TAB4202, TAB5179), befolkningen per ettårsålder och befolkningsförändringar; Kolada för omsorgskostnad per invånare
och nettokostnad per verksamhet. Arkiv data/downloads/20261119T090538Z. Kompletteringar från årsredovisning och kontroll av total befolkning dokumenteras i respektive kommuns data. Anläggningstillgångarna innehåller
pågående arbeten, som SCB inte särredovisar. Skulden är kommunens egna lån: det som
kommunen har lånat upp och lånat vidare till sina bolag ingår inte, och räntan på den delen är borttagen ur både
räntekostnad och finansiella intäkter. Definitionerna står i scripts/prepare_municipality.py.</p></html>"));
  end Data;

  model Continuous "Linköpings ekonomi med kontinuerlig tid inom året: lager och flöden"
    // Linköping: likviditet minst en månads löpande utgifter, räknat som bankmedel plus tillgängliga checkkrediter
    // (Kommunens riskinstruktion, KS 2025-12-16 § 326, avsnitt 2.1). Koncernens checkkredit 2 100 mnkr delas med
    // bolagen och kommunen hade 787 mnkr utnyttjat vid årsskiftet (årsredovisning 2025, s. 18 och not 20); kommunens
    // outnyttjade del anges inte, så noll antas. Källa: https://www.linkoping.se/kommun-och-politik/sa-styrs-
    // linkopings-kommun/regler-och-styrande-dokument
    extends Kommunekonomi.Continuous.Economy(base = Data.linkoping2025, olderShares = Data.olderShares, reserveDays = 30, creditLine = 0);
    annotation(experiment(StartTime = 2025, StopTime = 2033, Interval = 0.0833333333333333),
      Documentation(info = "<html><p><b>Tid: start 2025, slut 2033.</b> Med standardantagandena (illustrativ tillväxt).
Pengar och invånare är lager och flöden i kontinuerlig tid inom året (Kommunekonomi.Continuous.Economy). Starta från
ett annat år med <code>Continuous(base = Data.linkoping2024)</code>.</p></html>"));
  end Continuous;

  package Examples "Färdiga modeller att simulera"
    model Hindcast2025 "Starta i bokslutet 2024 och räkna fram 2025; jämför med utfallet i Data.linkoping2025"
      extends Continuous(base = Data.linkoping2024, olderShares = Data.olderShares2024, horizon = 1);
      annotation(experiment(StartTime = 2024, StopTime = 2025, Interval = 0.0833333333333333));
    end Hindcast2025;
  end Examples;
  annotation(uses(Kommunekonomi(version = "0.1.0")), Documentation(info = "<html><p>Linköping (kommunkod 0580) med biblioteket
<a href=\"modelica://Kommunekonomi\">Kommunekonomi</a>. Data från SCB och Kolada, genererade av scripts/prepare_municipality.py.
Detta är en forskningsmodell, inte kommunens prognos.</p></html>"));
end Linkoping;
